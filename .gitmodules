[submodule "third_party/munt"]
	path = third_party/munt
	url = https://github.com/munt/munt.git
	# The build generates config.h and patches ResamplerModel.cpp inside
	# the submodule (see the build/mt32/.prepared rule) — that dirt is
	# expected and must not show up in git status.
	ignore = dirty
[submodule "third_party/nuked_sc55"]
	path = third_party/nuked_sc55
	url = https://github.com/nukeykt/Nuked-SC55.git
